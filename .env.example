# Clé API Mistral (https://console.mistral.ai) — côté serveur uniquement
MISTRAL_API_KEY=votre_cle_mistral_ici
MISTRAL_MODEL=mistral-small-latest
# Modèle Vision Mistral Pixtral pour le Photo-Scan BL chantier (/api/ocr-bl)
MISTRAL_VISION_MODEL=pixtral-12b-2409

# Supabase (https://supabase.com/dashboard) — optionnel pour tester en mode local
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_supabase_ici

# Pont API Pennylane v2 (https://app.pennylane.com — Paramètres > Connectivité > API v2)
# Côté serveur uniquement — sans clé configurée, le pont fonctionne en mode Simulation (Dry-Run JSON)
PENNYLANE_API_TOKEN=votre_token_api_v2_pennylane
PENNYLANE_API_BASE_URL=https://app.pennylane.com/api/external/v2
# Optionnel : uniquement si vous utilisez un jeton cabinet / multi-dossiers
PENNYLANE_COMPANY_ID=
